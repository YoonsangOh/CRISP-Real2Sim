!MotionTracking/motion_tracking/data/
!MotionTracking/motion_tracking/data/assets/
MotionTracking/motion_tracking/data/assets/**
!MotionTracking/motion_tracking/data/assets/__init__.py
!MotionTracking/motion_tracking/data/assets/skeleton_configs.py

